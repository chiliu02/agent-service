# Copy to `.env` and fill in. `.env` is gitignored at every level; this file is
# tracked and must never contain a real value.
#
# THE CREDENTIAL. The agent names its own accepted variables when it refuses
# (GP-07), and these are that list: one real credential and two provider
# selectors. A selector satisfies the boot gate and authenticates nothing by
# itself, which is why they are published as two lists.
GEMINI_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=
# GOOGLE_GENAI_USE_GCA=

# A ROUTE THIS GATE CANNOT SEE. The agent also reads an auth method from
# <home>/.gemini/settings.json, so a mounted home carrying an earlier login is
# already authenticated with no variable set. Such a deployment must start with:
# AGENT_SERVICE_REQUIRE_CREDENTIALS=false

# The directory the agent may read and write. REQUIRED by compose, and the
# service exits 3 without it rather than writing into the container's own layer
# and discarding everything on stop. Windows: use FORWARD slashes.
# WORKSPACE_HOST_PATH=C:/path/to/scratch-or-repo

# For a checkout rather than a container: there is nothing to check, because
# ./workspace is an ordinary directory the service creates on first run.
AGENT_SERVICE_REQUIRE_MOUNTS=false

# THE SERVICE'S OWN CREDENTIAL, which is not the agent's. Set it and every /v1
# request needs `Authorization: Bearer <token>`; /healthz never does, because the
# container's healthcheck reads it. Per instance, never shared across a fleet.
# AGENT_SERVICE_AUTH_TOKEN=

# Optional.
# AGENT_SERVICE_MAX_SESSIONS=8
# AGENT_SERVICE_TURN_TIMEOUT_S=600
# AGENT_SERVICE_LOG_LEVEL=INFO
# AGENT_SERVICE_MODEL=gemini-3.1-flash-lite
