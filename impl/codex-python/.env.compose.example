# Copy to `.env` beside compose.yaml and fill in. `.env` is gitignored at the
# platform root, unanchored, so this file is the only one of the pair that is
# tracked -- and it must never contain a real value.
#
# **Compose reads `.env` automatically and this file is not it.** Nothing here
# is loaded by anything; it exists so the variable list is reviewable. Note that
# `.env` is NOT injected wholesale into the container either: only the keys
# named under `environment:` in compose.yaml cross the boundary.
#
# **Forward slashes in every path, even on Windows.** Compose's interpolation
# eats backslashes, so `C:\repo` arrives as `C:repo` and the mount silently
# lands somewhere else.

# --- required ---------------------------------------------------------------

# The host directory the agent works in, mounted at /workspace. Mount a
# repository ROOT, not a subdirectory: mounting `repo/src` leaves `.git` outside
# the container and every git command fails with "not a git repository".
#
# THE AGENT CAN WRITE ANYTHING HERE AND RUN COMMANDS AGAINST IT. Codex sandboxes
# the turn to this directory (`options.py` never selects `full_access`), so this
# path is the blast radius. Point it at a checkout you are willing to lose.
WORKSPACE_HOST_PATH=C:/path/to/your/repo

# A credential, and EITHER name works -- `OPENAI_API_KEY` wins if both are set.
# Without one the service refuses to boot with exit 3, naming what to set.
#
# **The app-server does not read these.** This service reads whichever is set
# and performs `login_api_key()` itself at session open; see
# docs/sdk-assessment.md §12. That is why the names work at all.
OPENAI_API_KEY=
# CODEX_API_KEY=

# --- optional ---------------------------------------------------------------

# The host port. 8001 by default so this stack can run beside the Claude build's,
# which publishes 8000. The CONTAINER port stays 8000 in both and must not move:
# it is what `agent-service-spec` publishes as `listen.port`.
# HOST_PORT=8001

# Provenance stamped on every SessionRecord, so a consumer can tell which
# container created a session. Opaque to this service; it neither parses it nor
# acts on it. Unprefixed on purpose -- whatever provisions the container sets it.
# AGENT_ID=

# Concurrent sessions. Each one is a `codex app-server` subprocess, NOT one
# request and not one turn: it is spawned by POST /v1/sessions and stays resident
# between turns until DELETE or until the reaper sweeps it at 1800s idle. So this
# is "how many app-servers may exist in this container at once", and idle ones
# cost memory too. Paired with `mem_limit` in compose.yaml -- raise both or
# neither, and read the note there first: the per-session cost is UNMEASURED.
# AGENT_SERVICE_MAX_SESSIONS=4

# Start without a credential -- for a docs-only boot, or a harness. It also has a
# legitimate production use here that the Claude build has no equivalent for: a
# `codex-home` volume carrying a login from an earlier run is already
# authenticated, and the boot gate cannot see that.
# AGENT_SERVICE_REQUIRE_CREDENTIALS=false

# What this service's own records are filtered at. INFO by default, which is
# what makes the shutdown summary and the reaper's line visible at all -- until
# 2026-08-10 nothing configured logging and every record below WARNING was
# dropped by Python's last-resort handler. Case-insensitive; an unknown value
# stops the boot naming the valid set. Does not touch uvicorn's own access log.
# AGENT_SERVICE_LOG_LEVEL=INFO

# Start with an unmounted workspace. Leave this alone unless you know why you
# want it: without the mount, everything the agent writes is discarded when the
# container stops, and the directory exists so nothing else notices.
# AGENT_SERVICE_REQUIRE_MOUNTS=false

# --- host-dependent, and the defaults are for a WINDOWS host -----------------
#
# On a Linux or WSL2 host set BOTH of these, or the container's git will convert
# the host's line endings to CRLF on the next checkout and hide real mode
# changes from the agent. See compose.yaml for the measurements.
# GIT_AUTOCRLF=input
# GIT_FILEMODE=true

# Who agent-authored commits are attributed to.
# GIT_AUTHOR_NAME=agent-service
# GIT_AUTHOR_EMAIL=agent-service@localhost
# GIT_COMMITTER_NAME=agent-service
# GIT_COMMITTER_EMAIL=agent-service@localhost

# --- NOT here, on purpose ----------------------------------------------------
#
# AGENT_SERVICE_AUTH_TOKEN. This build reads it, publishes `auth_required` from
# it, and enforces nothing -- so setting it produces an API that answers every
# unauthenticated request while /healthz says it is protected. The service
# refuses to boot rather than do that. Put a relay that holds the credential in
# front of this container, or wait for bearer auth to be implemented here.
#
# AGENT_SERVICE_DATABASE_URL. This build has no persistence: the history routes
# answer 404 with `type: .../persistence-disabled`. Setting it does nothing.
#
# AGENT_SERVICE_REFERENCE_DIRS. A Codex thread takes a `cwd` and nothing else,
# so a read-only reference mount would be invisible to the agent.
# `/v1/capabilities` publishes `reference_dirs: []`, which is the honest answer.
