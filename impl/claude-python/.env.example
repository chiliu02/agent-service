# Copy to `.env` and fill in. `.env` is gitignored — never commit it.

# Get one from https://platform.claude.com/
#
# A claude.ai subscription ALSO works -- the SDK spawns the same Claude Code
# binary and reads the same OAuth credential (measured 2026-09-05). What blocks
# it is this service's boot gate, which only checks for the names listed below;
# `AGENT_SERVICE_REQUIRE_CREDENTIALS=false` gets past it. Leave this EMPTY if you
# want that: a present-but-invalid key is used and does NOT fall back to OAuth.
# docs/claude-python-auth.md has the measurements, the precedence rules and the
# container recipe.
ANTHROPIC_API_KEY=

# --- Optional: alternative auth providers (instead of the API key above) ---
# CLAUDE_CODE_USE_BEDROCK=
# CLAUDE_CODE_USE_VERTEX=
# CLAUDE_CODE_USE_FOUNDRY=

# --- Optional: service settings (see docs/design.md) ---
# AGENT_SERVICE_WORKSPACE_DIR=
# AGENT_SERVICE_REFERENCE_DIRS=

# In-process write confinement. Default "none": no in-process control is
# wired up at all -- the container and its mount split are the only
# boundary. "hook" attaches a PreToolUse hook that confines Write/Edit/
# NotebookEdit to the workspace -- measured live to actually block a write,
# but it does NOT cover Bash (enabled by default): a shell redirect bypasses
# it. See README.md and docs/spike-findings.md, "Permission enforcement --
# measured, not guessed".
# AGENT_SERVICE_PERMISSION_ENFORCEMENT=none

# Per-run guardrails: default applied when a request doesn't specify one,
# and the hard cap a request may not exceed. Shown here at their defaults.
# AGENT_SERVICE_DEFAULT_MAX_TURNS=30
# AGENT_SERVICE_MAX_ALLOWED_TURNS=200
# AGENT_SERVICE_DEFAULT_MAX_BUDGET_USD=2.0
# AGENT_SERVICE_MAX_ALLOWED_BUDGET_USD=10.0
# AGENT_SERVICE_DEFAULT_REQUEST_TIMEOUT_S=600
# AGENT_SERVICE_MAX_ALLOWED_TIMEOUT_S=1800

# Mount guard. ON by default, because the container that most needs it is the
# one least likely to remember a flag (open question Q14). A checkout is not a
# container -- ./workspace is an ordinary directory, never a mount point -- so
# this opt-out is REQUIRED here, not optional: without it the service exits 3.
# compose.yaml sets it back to true for the container.
AGENT_SERVICE_REQUIRE_MOUNTS=false
