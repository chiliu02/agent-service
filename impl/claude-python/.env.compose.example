# Variables read by `compose.yaml`. PLACEHOLDERS ONLY -- never put a real key
# in this file; it is committed.
#
# Compose automatically reads a file named `.env` sitting beside `compose.yaml`,
# and that is the same `.env` that `.env.example` describes for local
# (non-container) runs. So the intended flow is:
#
#     cp .env.example .env          # if you have not already
#     cat .env.compose.example >> .env
#     # edit .env: fill in the key and the two host paths
#     docker compose up --build
#
# One secrets file, gitignored and dockerignored. `.env` is NOT injected into
# the container wholesale -- only the keys listed under `environment:` in
# compose.yaml cross the boundary, so anything else you keep in `.env` stays on
# the host.

# --- Host paths to mount ---------------------------------------------------
# Both are REQUIRED: compose fails with a named error rather than mounting
# something unintended if either is missing.
#
# On Windows use FORWARD slashes (C:/Users/you/...) -- backslashes are eaten by
# compose's interpolation. Mount the repository ROOT, not a subdirectory:
# mounting `repo/src` leaves `.git` outside the container and every git command
# fails with "not a git repository".

# Read-WRITE. Becomes /workspace inside the container and the agent's cwd.
# This is where the agent may create, edit and delete files -- point it at a
# scratch directory or a repo you are willing to have modified.
WORKSPACE_HOST_PATH=C:/path/to/your/scratch-or-repo

# Read-ONLY. Becomes /reference/<REFERENCE_NAME> inside the container, mounted
# `:ro`, and is listed in the SDK's add_dirs. The agent can read, Glob and Grep
# it and CANNOT write to it -- that is enforced by the kernel (EROFS), not by
# the agent's cooperation.
#
# If you have no reference repo: comment out the `${REFERENCE_HOST_PATH}` volume
# line in compose.yaml and set AGENT_SERVICE_REFERENCE_DIRS to `[]` there.
REFERENCE_HOST_PATH=C:/path/to/a/reference-repo

# The name the reference repo appears under: /reference/<this>. Optional,
# defaults to `reference`. Used for BOTH the mount path and the add_dirs entry,
# which must match exactly -- see the comment in compose.yaml for what a
# mismatch looks like (it fails silently).
# REFERENCE_NAME=acme-api

# Add more reference repos by repeating the volume line in compose.yaml and
# extending the JSON list, e.g.
#     - ${WEB_REPO_PATH}:/reference/acme-web:ro
#     AGENT_SERVICE_REFERENCE_DIRS: '["/reference/acme-api","/reference/acme-web"]'

# --- Credentials -----------------------------------------------------------
# Required unless AGENT_SERVICE_REQUIRE_CREDENTIALS=false below. Get one from
# https://platform.claude.com/ -- the claude.ai subscription login used by the
# Claude Code CLI is NOT valid for SDK-powered products.
#
# Alternative providers (CLAUDE_CODE_USE_BEDROCK / _VERTEX / _FOUNDRY) are not
# forwarded by compose.yaml as shipped; add them to `environment:` if you use
# one.
#
# LEFT COMMENTED OUT ON PURPOSE, unlike the two mount paths above. This file is
# APPENDED to a `.env` that already came from `.env.example`, which assigns
# `ANTHROPIC_API_KEY=` itself -- and dotenv/compose take the LAST assignment.
# An uncommented empty assignment here therefore silently blanked the real key
# the operator had just set at the top of the same file, and the container
# exited 3 telling them to set a variable that was visibly already set. Set the
# key ONCE, wherever it already appears in your `.env`.
# ANTHROPIC_API_KEY=

# THE SERVICE REFUSES TO BOOT WITHOUT A CREDENTIAL. With ANTHROPIC_API_KEY
# empty and this left at its default, the container does not start: it prints a
# message naming exactly what to set, exits 3, binds no port, and STAYS DOWN
# (compose.yaml sets `restart: "no"` on purpose). `docker compose ps` shows
# `Exited (3)` and `docker compose logs` ends with the message. That is the
# intended failure, not a bug -- see docs/deployment.md, "Boot without
# credentials".
#
# Set to false only for docs-only use (/docs, /openapi.json, /v1/capabilities)
# or for container tests that must not spend money. The default is true because
# otherwise every session spawns an agent subprocess that cannot authenticate
# and holds one of the session slots until the idle reaper sweeps it 1800 s
# later -- the failure surfaces after the cap is full instead of at boot.
# AGENT_SERVICE_REQUIRE_CREDENTIALS=false

# --- How many agents may run at once ---------------------------------------
# One session is one long-lived `claude` subprocess, spawned by POST /sessions
# and RESIDENT BETWEEN TURNS until DELETE or until the idle reaper sweeps it
# 1800 s later. So this is "how many `claude` processes this container may hold
# at once", and idle ones cost memory just like busy ones.
#
# compose.yaml sets 4, overriding config.py's default of 8, and it is PAIRED
# WITH `mem_limit: 1536m` there: 4 sessions project to ~690 MiB against that
# ceiling, 8 to ~1130 MiB. The cap exists to fail GRACEFULLY (429, caller
# retries) before mem_limit fails BRUTALLY (OOM kill, exit 137, and with
# `restart: "no"` the container stays down and every other live session dies
# with it).
#
# Raise this only together with mem_limit. Note that subagents -- the agent's
# own `Task` tool -- run inside a session's EXISTING subprocess and consume no
# slot, so a session that fans out costs well above the ~110 MiB one measured
# session did while still counting as 1 here. That headroom is what 4 buys.
# AGENT_SERVICE_MAX_SESSIONS=8

# --- Logging ---------------------------------------------------------------
# The level applied to this service's own logs at startup. INFO is the default
# and is what makes the container observable: the reaper's "closed N idle
# session(s)" and close_all()'s shutdown summary are both INFO, and at WARNING
# you get neither. Nothing sensitive is logged at INFO (verified: no
# credential, prompt or model output). DEBUG additionally turns on the SDK's
# and anyio's debug output, which is verbose and has NOT been audited for what
# it prints -- use it to debug, not to run.
# AGENT_SERVICE_LOG_LEVEL=DEBUG

# --- Git settings that DEPEND ON YOUR HOST ---------------------------------
# READ THIS BEFORE RUNNING ON A LINUX OR WSL2 HOST. Both defaults below are for
# a WINDOWS host (the target docs/deployment.md documents). Both are WRONG on a
# Linux host, and neither fails loudly if you get it wrong -- one rewrites your
# repository's line endings, the other hides real permission changes.
#
# core.autocrlf. Your ~/.gitconfig does not cross the mount, so the container's
# git does not know your host normalizes line endings. On Windows, where the
# working tree is CRLF and the index is LF, leaving this unset makes the
# container see EVERY LINE OF EVERY TEXT FILE as modified (measured on this
# repo: 26,261 insertions, 26,261 deletions, zero mode changes), makes
# `git status` 12.5x slower, and -- the reason this variable exists -- means one
# `git add -A && git commit` by the agent COMMITS THE WHOLE REPO'S LINE ENDINGS
# INTO HISTORY. `true` is correct for a Windows host: measured to write CRLF
# back to the host byte-identically to the host's own checkout.
#
#   Windows host (Docker Desktop, repo on C:)   -> true      (the default)
#   Linux host, or repo moved into WSL2         -> input
#
# `input` and not `false` on Linux: the tree is already LF there, and `input`
# additionally normalizes anything a Windows editor touched. `true` on a Linux
# host would convert that host's own files to CRLF on the next checkout.
# GIT_AUTOCRLF=input

# core.filemode. Docker Desktop reports every mounted file as mode 0777, which
# git reads as `100644 => 100755` on every tracked file. `false` is right on
# Windows. On Linux the exec bit is real and `false` would hide genuine mode
# changes from the agent.
#
#   Windows host   -> false     (the default)
#   Linux / WSL2   -> true
# GIT_FILEMODE=true
#
# Both are delivered as GIT_CONFIG_KEY_n/VALUE_n (see compose.yaml) rather than
# `git config` in the image, because `.git/config` is inside the mount and REPO
# SCOPE BEATS SYSTEM SCOPE -- a baked value is silently overridden by the
# mounted repo's own. The environment channel is read after all config files and
# is the only one that wins.
#
# The portable alternative, if you own the repository: commit a `.gitattributes`
# with `* text=auto`. That fixes the line endings for every clone, on every
# host, and makes GIT_AUTOCRLF irrelevant.

# --- Git identity ----------------------------------------------------------
# The container has no ~/.gitconfig, so without these `git commit` fails with
# "Please tell me who you are". All four have the defaults shown; override them
# if you want agent commits attributed differently. Keeping them distinct from
# your own identity is deliberate -- it makes agent-authored commits obvious in
# `git log`.
# GIT_AUTHOR_NAME=agent-service
# GIT_AUTHOR_EMAIL=agent-service@localhost
# GIT_COMMITTER_NAME=agent-service
# GIT_COMMITTER_EMAIL=agent-service@localhost

# Refuse to start when the two mounts above are not really there. ON by
# default in the container (config.py defaults it to false, which is right for
# a plain checkout). Neither Docker nor compose checks this for you -- `-v`,
# `--mount type=bind` and even `create_host_path: false` were all measured to
# CREATE a missing host directory and start anyway -- so without it a typo in
# a path above gives you an empty /workspace that looks healthy. Set it to
# false only for a docs-only boot or a test harness.
# AGENT_SERVICE_REQUIRE_MOUNTS=true

# --- Not set here ----------------------------------------------------------
# AGENT_SERVICE_WORKSPACE_DIR and AGENT_SERVICE_REFERENCE_DIRS are set by
# compose.yaml itself from the mount paths above, so they cannot drift from
# what is actually mounted. Do not override them here.
#
# AGENT_SERVICE_MAX_SESSIONS is set by compose.yaml to 4, which is NOT
# config.py's default of 8 -- see the section above for why, and change it
# there (or via this variable) rather than assuming the code default applies.
#
# Every other AGENT_SERVICE_* setting from config.py (model, limits, permission
# enforcement) keeps its default; add it to `environment:` in compose.yaml to
# change it.
