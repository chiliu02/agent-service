# Copy to `.env` and fill in. `.env` is gitignored -- never commit it.

# --- credentials -------------------------------------------------------------
#
# **Set ONE of these three.** They are what the boot gate checks, and each has
# driven a real turn through this agent. The underlying tool reaches thirty-plus
# providers; a deployment using a fourth sets
# AGENT_SERVICE_REQUIRE_CREDENTIALS=false below, because the gate cannot check
# what it does not name.
#
# **A credential in the agent's own auth.json OUTRANKS every variable here** and
# is invisible to the gate. If that is your deployment, start with the gate off.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- which model ------------------------------------------------------------
#
# **`provider/id` in ONE string.** The agent accepts a qualified model, so a
# caller's `options.model` needs no companion field and neither does this:
#
#     AGENT_SERVICE_MODEL=anthropic/claude-haiku-4-5
#     AGENT_SERVICE_MODEL=openai/gpt-5-nano
#     AGENT_SERVICE_MODEL=google/gemini-3.1-flash-lite
#
# A bare id works too, paired with AGENT_SERVICE_PROVIDER. Left unset, the agent
# chooses from whatever credentials it finds -- which is a real deployment but
# an unpredictable bill, so set it.
AGENT_SERVICE_MODEL=

# The provider for a BARE model id. Ignored when the model above is qualified.
# AGENT_SERVICE_PROVIDER=anthropic

# --- where the agent lives ---------------------------------------------------
#
# Outside a container these default to ./workspace and ./temp/*, which is why a
# plain checkout runs with no edits at all. The image sets them to /workspace
# and /var/lib/agent-service/*.
# AGENT_SERVICE_WORKSPACE_DIR=./workspace
# AGENT_SERVICE_AGENT_DIR_ROOT=./temp/agent-dirs
# AGENT_SERVICE_SESSION_STORE=./temp/sessions

# The agent binary. **On Windows this must be the `.cmd` shim**: the extensionless
# file beside it is a shell script and CreateProcess refuses it with WinError 193.
# AGENT_SERVICE_PI_BINARY=pi

# --- per-instance settings ---------------------------------------------------
#
# Shown at their defaults.
# AGENT_SERVICE_MAX_SESSIONS=8
# AGENT_SERVICE_TURN_TIMEOUT_S=600
# AGENT_SERVICE_SESSION_IDLE_TTL_S=1800
# AGENT_SERVICE_LOG_LEVEL=INFO

# THE SERVICE REFUSES TO BOOT WITHOUT A CREDENTIAL, exits 3, binds no port and
# stays down. Set to false only for a docs-only boot (/docs, /openapi.json,
# /v1/deployment) or for tests that must not spend money.
# AGENT_SERVICE_REQUIRE_CREDENTIALS=false

# Refuse to start if the workspace is not on a real mount, so that nothing the
# agent writes is silently discarded when the container stops. OFF by default
# outside a container, ON inside the image.
# AGENT_SERVICE_REQUIRE_MOUNTS=false

# The bearer token `/v1` requires. **Per instance, never per fleet.** Unset
# leaves the deployment open, which is published as `auth_required: false`.
# AGENT_SERVICE_AUTH_TOKEN=

# Where runs and transcripts are recorded. Unset disables persistence entirely,
# which is supported rather than degraded: the history routes then refuse with a
# named type and /healthz reports database_usable: null.
# AGENT_SERVICE_DATABASE_URL=
